				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a833ff63-c6bd-4884-b80b-d730ac9867ea")
	)
	(text "n = power convertion efficiency\nIdc = (VOUT*IOUT)/(VIN*n)\nIdc = (12V*2A)/(3.4V*90%) = 7.84A\n"
