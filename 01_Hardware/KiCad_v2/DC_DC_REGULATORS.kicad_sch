	(text "Vripple_dis = [(VOUT-VIN)*IOUT]/VOUT*fsw*Cout\nVripple_dis = [12V-3.4V*2A]/12*320KHz*(47uF*2) = 48mV\n\nVripp_ESR = ILpeak*Rc_esr\nVripp_ESR = 8.66A*30mOhms (at 320KHz esr between 10-50mOhms) = 260mV"
		(exclude_from_sim no)
		(at 152.908 56.134 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3336973f-6b63-4990-a9ce-50f39cf46130")
	)
	(text "Peak to Peak Inductor Current Ripple\nIpp = 1/L*[(1/(Vout-Vin))+(1/Vin)]*fsw \nOR\nIpp = (Vin*D)/(L*fsw)\n\nIpp = (3.4V * 0.73%) / (4.7uH*340KHz) = 1.65A"
		(exclude_from_sim no)
		(at 195.58 123.698 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3be1e902-9480-4710-86e0-9d98a5159684")
	)
	(text "Rlim = 400K / A\nRlin = 400K / 10A = 40K"
		(exclude_from_sim no)
		(at 159.004 116.84 0)
		(effects
