			)
			(justify left)
		)
		(uuid "7b080268-464e-4b91-9f1b-cef75dabf6c1")
	)
	(text "IL peak = Idc+(Ipp/2)\nIL peak = 7.84A+(1.65A/2) = 8.66A\nInductor must have a higher saturation current of 9A"
