	(text "VOUT = 12V\nVREF = 1V\nR109 = 14K3\n\nR108 = [(VOUT - VREF) * R109]/VREF\n\nR108 = [(12 - 1)* 14300]/1 = 157300 or 158K\n\nR108 = 158K"
		(exclude_from_sim no)
		(at 195.072 106.172 0)
		(effects
