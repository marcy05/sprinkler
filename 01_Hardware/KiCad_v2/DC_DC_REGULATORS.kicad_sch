	)
	(text "VOUT = 12V\nVREF = 1V\nR109 = 14K3\n\nR108 = [(VOUT - VREF) * R109]/VREF\n\nR108 = [(12 - 1)* 14300]/1 = 157300 or 158K\n\nR108 = 158K"
		(exclude_from_sim no)
		(at 319.532 72.644 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7b080268-464e-4b91-9f1b-cef75dabf6c1")
	)
	(text "IL peak = Idc+(Ipp/2)\nIL peak = 7.84A+(1.65A/2) = 8.66A\nInductor must have a higher saturation current of 9A"
		(exclude_from_sim no)
		(at 319.532 107.696 0)
		(effects
